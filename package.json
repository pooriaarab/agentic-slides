{
  "name": "agentic-slides",
  "version": "0.2.0",
  "description": "Build and present slide decks with people and agents.",
  "keywords": [
    "slides",
    "presentation",
    "deck",
    "collaboration",
    "agents",
    "mcp",
    "cli",
    "pptx"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-slides.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "fonts/OFL.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-slides",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    }
  },
  "bin": {
    "agentic-slides": "./dist/cli.js",
    "agentic-slides-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@noble/hashes": "^2.4.0",
    "agentic-identity": "^0.4.0",
    "agentic-realtime": "^0.2.0",
    "hono": "^4.9.0",
    "lib0": "^0.2.119",
    "yjs": "^13.6.33",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.40.0"
  }
}
