{
  "name": "agentic-slides",
  "version": "0.14.0",
  "description": "Build and present slide decks with people and agents.",
  "keywords": [
    "slides",
    "presentation",
    "deck",
    "collaboration",
    "agents",
    "mcp",
    "cli",
    "pptx"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-slides.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "fonts/OFL.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-slides",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/embed.css"
  },
  "bin": {
    "agentic-slides": "./dist/cli.js",
    "agentic-slides-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run e2e",
    "deploy:demo": "npm run build && wrangler deploy -c wrangler.demo.jsonc",
    "e2e": "playwright test",
    "e2e:screenshots": "UPDATE_SCREENSHOTS=1 playwright test",
    "dev": "npm run build && WRANGLER_SEND_METRICS=false wrangler dev --var SLIDES_REGION:unknown",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@noble/hashes": "^2.4.0",
    "agentic-design": "^0.8.0",
    "agentic-formats": "^0.4.2",
    "agentic-identity": "^0.9.0",
    "agentic-realtime": "^0.4.4",
    "hono": "^4.9.0",
    "lib0": "^0.2.119",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "overrides": {
    "agentic-design": {
      "zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.40.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
